// Copy this file to Secrets.xcconfig and fill in your own values.
// Secrets.xcconfig is gitignored; this example file is committed, so it must ONLY contain placeholders.
GMS_API_KEY = YOUR_IOS_KEY_HERE
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// The "$()" stops xcconfig treating "//" as a comment. It expands to nothing at build time.
AGENT_BASE_URL = https:/$\(\)/your-service.australia-southeast2.run.app
AGENT_ACCESS_TOKEN = the-token-stored-in-secret-manager
